      "tag": "🐳 · 2/6",
      "title": "What is wrong in Dockerfile?",
      "instruction": "Python ETL for prod.",
      "recallTips": [
        "Pin base image tag/digest — not :latest",
        "USER non-root in prod",
        "COPY after deps = better layer cache"
      ],
      "mission": {
        "emoji": "🐳",
        "title": "Image review",
        "brief": "Security + reproducibility."
      },
      "buggyCode": "FROM python:latest\nRUN pip install pandas\nCOPY . /app\nWORKDIR /app\nUSER root\nCMD python app.py",
      "prompt": "Two main problems?",
      "options": [
        ":latest + root USER — non-reproducible and unsafe image",
        "WORKDIR forbidden",
        "pandas cannot run in Docker",
        "CMD must always be ENTRYPOINT"
      ],
      "correctIndex": 0,
      "explainOk": "Pin base tag/digest; USER non-root; multi-stage if needed.",
      "explanation": "On interviews name both: tag + user."
    },
