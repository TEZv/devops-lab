    {
      "id": "L1",
      "type": "match_pairs",
      "tag": "🐧 · 1/6",
      "title": "MATCH · shell ↔ meaning",
      "instruction": "Junior DevOps / SRE screen basics — chmod schema first.",
      "studyIntro": "<strong>Step 1 · see the difference.</strong> 755 vs 777 on deploy.sh — why world-writable is a hole. Then pairs.",
      "studyViz": {
        "type": "splitCompare",
        "columns": [
          {
            "title": "chmod 755 deploy.sh ✓",
            "color": "#3d9a6a",
            "items": [
              "owner: rwx (read/write/execute)",
              "group: r-x (read + execute only)",
              "other: r-x",
              "not everyone can REPLACE the script"
            ]
          },
          {
            "title": "chmod 777 deploy.sh ✗",
            "color": "#ff6b6b",
            "items": [
              "owner: rwx",
              "group: rwx",
              "other: rwx — anyone can EDIT the file",
              "trojan deploy script = RCE / backdoor"
            ]
          }
        ]
      },
      "pairs": [
        {
          "left": "grep pattern file",
          "right": "Find lines by regex/text",
          "studyHint": "↑ pipeline L0"
        },
        {
          "left": "chmod 755 script.sh",
          "right": "rwx owner, rx group/other",
          "studyHint": "↑ 755 column"
        },
        {
          "left": "tail -f app.log",
          "right": "Follow log in real time"
        },
        {
          "left": "echo $? ",
          "right": "Exit code of last command"
        },
        {
          "left": "sudo -u deploy",
          "right": "Run as user deploy"
        }
      ]
    },
