      "mission": {
        "emoji": "🔐",
        "title": "Least privilege review",
        "brief": "Роль має читати лише acme-bronze-raw/*, не весь account."
      },
      "buggyCode": "resource \"aws_iam_role_policy\" \"etl\" {\n  policy = jsonencode({\n    Statement = [{\n      Effect   = \"Allow\"\n      Action   = \"*\"\n      Resource = \"*\"\n    }]\n  })\n}",
      "prompt": "Головний ризик?",
      "options": [
        "Action * + Resource * = admin на весь account",
        "jsonencode заборонений у Terraform",
        "ETL не може мати IAM role",
        "Потрібен Effect = Deny завжди"
      ],
      "correctIndex": 0,
      "explainOk": "s3:GetObject на arn:…:bucket/acme-bronze-raw/* — як DE cloud IAM trap.",
      "explanation": "На інтервʼю: назви principle of least privilege + конкретний ARN."
