    {
      "id": "K3",
      "type": "whats_wrong",
      "tag": "☸️ · 3/7",
      "title": "Probe trap",
      "instruction": "App listens on :8080/health, but…",
      "recallTips": [
        "liveness fail → kubelet restart → CrashLoop",
        "port/path must match app listen",
        "initialDelaySeconds > cold start"
      ],
      "buggyCode": "livenessProbe:\n  httpGet:\n    path: /health\n    port: 80\n  initialDelaySeconds: 0\n  periodSeconds: 1",
      "prompt": "Why CrashLoop?",
      "options": [
        "port 80 ≠ app on 8080 + initialDelay 0 — probe fail → kill → loop",
        "livenessProbe is forbidden",
        "periodSeconds must be 0",
        "path /health is always wrong"
      ],
      "correctIndex": 0,
      "explainOk": "readiness = traffic; liveness = restart. Ports and delay must match the app.",
      "explanation": "Interview: describe pod → Events → probe failed."
    },
    {
      "id": "K4",
      "type": "multi_choice",
      "tag": "☸️ · 4/7",
      "title": "Deployment or StatefulSet?",
      "instruction": "Postgres in K8s: stable network ID + persistent volume per replica.",
      "question": "Best workload controller?",
      "options": [
        "StatefulSet + PVC (stable pod name, ordered deploy)",
        "Bare Pod without controller",
        "CronJob",
        "Deployment without volume — data in emptyDir"
      ],
      "correctIndex": 0,
      "explanation": "Stateless app → Deployment. Stateful DB → StatefulSet or managed DB outside K8s."
    },
