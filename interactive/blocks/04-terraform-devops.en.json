      "mission": {
        "emoji": "📂",
        "title": "Lake bronze bucket",
        "brief": "Terraform creates S3 bucket for raw ingest. HCL name = resource label (not ARN).",
        "ask": "Fill resource type and label."
      },
      "sampleTable": {
        "headers": [
          "HCL label",
          "cloud object",
          "DE zone"
        ],
        "rows": [
          [
            "aws_s3_bucket.bronze_lake",
            "S3 bucket acme-bronze",
            "bronze / raw"
          ],
          [
            "aws_iam_role.etl_reader",
            "IAM role for Spark",
            "least privilege read"
          ]
        ],
        "columnGlossary": {
          "HCL label": "resource TYPE.NAME in .tf",
          "cloud object": "What appears after apply",
          "DE zone": "Same lake as DE Lab layer 7"
        },
        "caption": "resource «aws_s3_bucket» + label «bronze_lake» — Terraform knows ID after apply."
      },
      "controlTip": "HCL → cloud table above.",
      "template": "resource \"____\" \"____\" {\n  bucket = \"acme-bronze-raw\"\n  tags = { env = \"prod\", zone = \"bronze\" }\n}",
      "answers": [
        "aws_s3_bucket",
        "bronze_lake"
