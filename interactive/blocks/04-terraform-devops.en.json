    {
      "id": "T3",
      "type": "whats_wrong",
      "tag": "🏗️ · 3/7",
      "title": "What is wrong in IAM policy?",
      "instruction": "ETL role to read bronze bucket.",
      "recallTips": [
        "Least privilege: narrow Action + Resource",
        "s3:GetObject on prefix/*, not *",
        "Bridge: DE cloud A3 public * trap"
      ],
      "mission": {
        "emoji": "🔐",
        "title": "Least privilege review",
        "brief": "Role should read only acme-bronze-raw/*, not whole account."
      },
      "buggyCode": "resource \"aws_iam_role_policy\" \"etl\" {\n  policy = jsonencode({\n    Statement = [{\n      Effect   = \"Allow\"\n      Action   = \"*\"\n      Resource = \"*\"\n    }]\n  })\n}",
      "prompt": "Main risk?",
      "options": [
        "Action * + Resource * = admin on whole account",
        "jsonencode forbidden in Terraform",
        "ETL cannot have IAM role",
        "Need Effect = Deny always"
      ],
      "correctIndex": 0,
      "explainOk": "s3:GetObject on arn:…:bucket/acme-bronze-raw/* — like DE cloud IAM trap.",
      "explanation": "On interviews: name least privilege + concrete ARN."
    },
    {
      "id": "T4",
      "type": "multi_choice",
      "tag": "🏗️ · 4/7",
      "title": "Where to keep state?",
      "instruction": "Team of 4 DevOps, one pet AWS account, shared modules.",
      "question": "Best state practice?",
      "options": [
        "Remote backend: S3 + DynamoDB lock — one truth for team",
        "terraform.tfstate in everyone's Downloads/",
        "Commit state to public GitHub",
        "Delete state after apply"
      ],
      "correctIndex": 0,
      "explanation": "Local state = race + loss. Remote state + locking is a basic production contract."
    },
    {
      "id": "T5",
      "type": "scenario",
      "tag": "🏗️ · 5/7",
      "title": "Drift: bucket policy changed in console",
      "emoji": "⚠️",
      "scene": "terraform plan shows ~ update on bucket policy. Yesterday apply was green. Someone clicked in AWS Console.",
      "bestIndex": 0,
      "choices": [
        {
          "label": "Do not blind apply: find who/why changed → revert in console or fix .tf and apply",
          "feedback": "Drift triage — standard platform ritual."
        },
        {
          "label": "terraform apply -auto-approve without reading diff",
          "feedback": "May break prod policy."
        },
        {
          "label": "Delete state and start over",
          "feedback": "Terraform «forgets» resources — worse."
        }
      ]
    },
